PORT=4000
FRONTEND_ORIGIN=http://localhost:5174
DATABASE_URL=file:./fasalyn-production.db
# For Turso/libSQL remote databases only:
DATABASE_AUTH_TOKEN=
JWT_SECRET=generate-a-long-random-random-secret
AI_SERVICE_URL=http://localhost:8000
MAX_UPLOAD_BYTES=10485760
OFFICER_REVIEW_CONFIDENCE=0.70
# Required in production for officer self-registration. Local development uses
# `local-officer-setup` when this value is absent.
OFFICER_REGISTRATION_CODE=set-a-long-random-officer-enrollment-code
# Default is false. Enable only in isolated local development with a private
# environment value; never display a production enrollment secret in the UI.
OFFICER_SELF_REGISTRATION=false
