PORT=8000
# A verified Hugging Face image-classification model ID trained for your supported
# crops/classes. Do not point this to an unverified generic model.
DISEASE_MODEL_ID=
DISEASE_MODEL_REVISION=
MIN_MODEL_CONFIDENCE=0.60
MAX_IMAGE_BYTES=10485760
MIN_IMAGE_EDGE=96
# Set FORCE_CPU=1 for laptop/CPU development.
FORCE_CPU=1
